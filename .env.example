# Strikezone server configuration.
# Copy this file to .env and replace every placeholder. Never commit .env.
# The server refuses to start when a required variable is missing or invalid.

# --- runtime ---
# development | test | production
NODE_ENV=development
# Port for the single HTTP + Colyseus WebSocket server
PORT=2567
# The website's origin. Only this origin is allowed by CORS and by the
# Colyseus WebSocket origin check (http://localhost:3000 is also allowed when
# NODE_ENV=development).
SITE_ORIGIN=http://localhost:3000

# --- supabase (server-side only) ---
# Supabase Postgres is reached with the service role key, which bypasses RLS.
# Treat it as a root credential: server-side only, never shipped to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# --- signing / admin ---
# Signs match results. Use a long random string (>= 32 characters).
RESULT_SIGNING_SECRET=replace-with-a-random-string-at-least-32-characters-long
# Authenticates admin API calls (>= 24 characters).
ADMIN_API_KEY=replace-with-a-random-admin-api-key

# --- money ---
# virtual | real
MONEY_MODE=virtual
# ISO 4217 code. NGN amounts are integers in kobo.
CURRENCY=NGN
# House margin in basis points: 600 = 6.00%
HOUSE_MARGIN_BPS=600
