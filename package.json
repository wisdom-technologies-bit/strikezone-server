{
  "name": "strikezone-server",
  "version": "0.1.0",
  "private": true,
  "description": "Game and betting server for Strikezone, an online skill-game betting platform (Carrom first, then Ludo).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "carrom:demo": "tsx scripts/carrom-demo.ts",
    "verify-match": "tsx scripts/verify-match.ts",
    "carrom:watch": "tsx scripts/carrom-watch.ts",
    "tournament:demo": "tsx scripts/tournament-demo.ts",
    "odds:calibrate": "tsx scripts/odds-calibrate.ts",
    "odds:validate": "tsx scripts/odds-validate.ts",
    "odds:fit": "tsx scripts/odds-fit.ts",
    "odds:verify": "tsx scripts/odds-verify.ts",
    "odds:backtest": "tsx scripts/odds-backtest.ts"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.18.7",
    "@colyseus/schema": "^5.0.43",
    "@colyseus/ws-transport": "^0.18.4",
    "@supabase/supabase-js": "^2.118.0",
    "colyseus": "^0.18.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.8",
    "@colyseus/testing": "^0.18.6",
    "@eslint/js": "9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
