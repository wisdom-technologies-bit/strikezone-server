# Strikezone server configuration.
# Copy this file to .env and replace every placeholder. Never commit .env.
# The server refuses to start when a required variable is missing or invalid.

# --- runtime ---
# development | test | production
NODE_ENV=development
# Port for the single HTTP + Colyseus WebSocket server
PORT=2567
# The website's origin. Only this origin is allowed by CORS and by the
# Colyseus WebSocket origin check (http://localhost:3000 is also allowed when
# NODE_ENV=development).
SITE_ORIGIN=http://localhost:3000

# --- supabase (server-side only) ---
# Supabase Postgres is reached with the service role key, which bypasses RLS.
# Treat it as a root credential: server-side only, never shipped to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# --- signing / admin ---
# Signs match results. Use a long random string (>= 32 characters).
RESULT_SIGNING_SECRET=replace-with-a-random-string-at-least-32-characters-long
# Authenticates admin API calls (>= 24 characters).
ADMIN_API_KEY=replace-with-a-random-admin-api-key

# --- money ---
# virtual | real
MONEY_MODE=virtual
# ISO 4217 code. NGN amounts are integers in kobo.
CURRENCY=NGN
# House margin in basis points: 600 = 6.00%
HOUSE_MARGIN_BPS=600
# Spectators: the cap per room, the joins one address may make a minute, and the
# public API's requests per minute per address.
MAX_SPECTATORS_PER_ROOM=2000
SPECTATOR_JOIN_PER_MINUTE=60
PUBLIC_API_RATE_PER_MINUTE=120

# --- limits, away from a single route ---
# Requests one address may make a minute across the whole HTTP surface. The public
# reads above keep their own, tighter limit.
GLOBAL_RATE_PER_MINUTE=600
# The largest JSON body the server will read, in kilobytes.
BODY_LIMIT_KB=100
# A room message larger than this is refused, and a client sending more than
# MAX_MESSAGES_PER_SECOND for a few seconds is disconnected.
MAX_MESSAGE_BYTES=4096
MAX_MESSAGES_PER_SECOND=20

# --- the admin gate ---
# Wrong keys one address may send before it is locked out, and for how long.
ADMIN_LOCKOUT_THRESHOLD=10
ADMIN_LOCKOUT_MS=900000

# --- alerts (optional, but a floor without an alert is not a control) ---
# Warn when the free bankroll falls below this, in minor units.
ALERT_FREE_BANKROLL_MINOR=1000000
# Where alerts are POSTed. Unset means the alerts table only.
ALERT_WEBHOOK_URL=
# Sentry is optional: without a DSN nothing is sent and nothing is logged.
SENTRY_DSN=

# The largest stake the API will accept, in minor units.
MAX_STAKE_MINOR=5000000

# --- house fixtures -------------------------------------------------------
# Bot matches that keep the lobby supplied. Off by default: deploying this code
# changes nothing until this is true.
FIXTURES_ENABLED=false
# How many fixtures stay scheduled at once. 0 stops new ones being created.
UPCOMING_FIXTURES_TARGET=4
# The gap between two fixtures' start times, in minutes.
FIXTURE_INTERVAL_MINUTES=5
# How long the first fixture's window is open before it starts, in seconds.
BET_WINDOW_SECONDS=120
# Bot matches allowed to run at the same time. Keep it low on a small host.
MAX_CONCURRENT_HOUSE_MATCHES=2
# The games fixtures alternate between, in order.
FIXTURE_GAMES=carrom,ludo
